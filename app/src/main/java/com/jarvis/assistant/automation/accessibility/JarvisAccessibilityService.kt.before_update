    override fun onCreate() {
        super.onCreate()
        instance = this
        Log.i(TAG, "JarvisAccessibilityService created")
    }

    override fun onDestroy() {
        super.onDestroy()
        instance = null
        Log.i(TAG, "JarvisAccessibilityService destroyed")
    }

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        if (event == null) return

        try {
            // Update UI change timestamp for any event
            _uiChanges.value = UiChange(
                System.currentTimeMillis(),
                event.packageName?.toString() ?: "",
                event.eventType,
                System.currentTimeMillis()
            )

            // Extract OTP from text events
            if (event.eventType == android.view.accessibility.AccessibilityEvent.TYPE_VIEW_TEXT_CHANGED ||
                event.eventType == android.view.accessibility.AccessibilityEvent.TYPE_VIEW_TEXT_SELECTION_CHANGED ||
                event.eventType == android.view.accessibility.AccessibilityEvent.TYPE_VIEW_FOCUSED) {

                val source = event.source
                if (source != null) {
                    val text = source.text
                    if (text != null && text.isNotBlank()) {
                        val otpMatch = Regex("\\b\\d{4,6}\\b").find(text)
                        if (otpMatch != null) {
                            latestExtractedOtp = ExtractedOtp(otpMatch.value, System.currentTimeMillis())
                            Log.i(TAG, "OTP extracted: ${otpMatch.value}")
                        }
                    }
                }
            }
        } catch (e: Exception) {
            Log.e(TAG, "Error processing accessibility event: ${e.message}", e)
        }
    }

    // --- Safe node search methods with depth limits to prevent stack overflow ---

    /**
     * Find a node by text with recursion depth limit.
     *
     * @param node   The root node to search from
     * @param text   The text to search for
     * @param exact  Whether to match exactly or contain
     * @param maxDepth Maximum recursion depth (default 15)
     * @return The first matching node or null
     */
    fun findNodeByText(node: AccessibilityNodeInfo?, text: String, exact: Boolean = false, maxDepth: Int = 15): AccessibilityNodeInfo? {
        if (node == null) return null
        return findNodeByTextRecursive(node, text, exact, 0, maxDepth)
    }

    private fun findNodeByTextRecursive(
        node: AccessibilityNodeInfo,
        text: String,
        exact: Boolean,
        depth: Int,
        maxDepth: Int
    ): AccessibilityNodeInfo? {
        if (depth > maxDepth) return null

        val nodeText = node.text?.toString()?.trim() ?: ""
        val matches = if (exact) nodeText.equals(text, ignoreCase = true) else nodeText.contains(text, ignoreCase = true)

        if (matches && node.isVisibleToUser) {
            return node
        }

        // Search children
        for (i in 0 until node.childCount) {
            val child = node.getChild(i) ?: continue
            val result = findNodeByTextRecursive(child, text, exact, depth + 1, maxDepth)
            if (result != null) return result
        }

        return null
    }

    /**
     * Find all nodes matching text with visited set prevention to avoid infinite loops.
     *
     * @param node   The root node to search from
     * @param text   The text to search for
     * @param exact  Whether to match exactly or contain
     * @param maxDepth Maximum recursion depth (default 15)
     * @return List of all matching nodes
     */
    fun findAllNodesByText(node: AccessibilityNodeInfo?, text: String, exact: Boolean = false, maxDepth: Int = 15): List<AccessibilityNodeInfo> {
        val results = mutableListOf<AccessibilityNodeInfo>()
        val visited = mutableSetOf<AccessibilityNodeInfo>()
        if (node != null) {
            collectAllNodesByText(node, text, exact, 0, maxDepth, results, visited)
        }
        return results
    }

    private fun collectAllNodesByText(
        node: AccessibilityNodeInfo,
        text: String,
        exact: Boolean,
        depth: Int,
        maxDepth: Int,
        results: MutableList<AccessibilityNodeInfo>,
        visited: MutableSet<AccessibilityNodeInfo>
    ) {
        if (depth > maxDepth || !visited.add(node)) return

        val nodeText = node.text?.toString()?.trim() ?: ""
        val matches = if (exact) nodeText.equals(text, ignoreCase = true) else nodeText.contains(text, ignoreCase = true)

        if (matches && node.isVisibleToUser) {
            results.add(node)
        }

        // Search children
        for (i in 0 until node.childCount) {
            val child = node.getChild(i) ?: continue
            collectAllNodesByText(child, text, exact, depth + 1, maxDepth, results, visited)
        }
    }

    /**
     * Safely traverse the accessibility node tree with depth limit and visited set.
     *
     * @param node    The root node to traverse
     * @param maxDepth Maximum recursion depth (default 20)
     * @param action  The action to perform on each node
     */
    fun traverseSafe(node: AccessibilityNodeInfo?, maxDepth: Int = 20, action: (AccessibilityNodeInfo) -> Unit) {
        if (node == null) return
        val visited = mutableSetOf<AccessibilityNodeInfo>()
        traverseSafeRecursive(node, 0, maxDepth, action, visited)
    }

    private fun traverseSafeRecursive(
        node: AccessibilityNodeInfo,
        depth: Int,
        maxDepth: Int,
        action: (AccessibilityNodeInfo) -> Unit,
        visited: MutableSet<AccessibilityNodeInfo>
    ) {
        if (depth > maxDepth || !visited.add(node)) return

        try {
            action(node)
        } catch (e: Exception) {
            Log.w(TAG, "Error in traverse action: ${e.message}")
        }

        // Traverse children
        for (i in 0 until node.childCount) {
            val child = node.getChild(i) ?: continue
            traverseSafeRecursive(child, depth + 1, maxDepth, action, visited)
        }
    }

