<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_icon_square"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tvChannelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/themeAccent"
        android:textStyle="bold"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvUploadTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Prompt (today, unique to this channel)"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textIsSelectable="true"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Hook"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvHook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textIsSelectable="true"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="SEO"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvSeo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textIsSelectable="true"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Logo/branding for editing"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvLogoNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textIsSelectable="true"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="13sp" />

</LinearLayout>
